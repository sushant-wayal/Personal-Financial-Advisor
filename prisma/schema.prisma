generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id               String    @id @default(cuid())
  amount           Float
  merchant         String
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id])
  paymentMethod    String?
  bankName         String?
  timestamp        DateTime  @default(now())
  source           String
  sourceMessageId  String?   @unique
  account          String?
  transactionType  String    @default("OTHER")
  type             String
  notes            String?
  confidence       Float     @default(1.0)
  parsedAt         DateTime  @default(now())
  rawText          String    @default("")
  raw              String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  isClubbed        Boolean   @default(false)
  clubbedSourceIds String    @default("[]")
  clubbedSources   String    @default("[]")
}

model TransactionIngestionKey {
  id              String   @id @default(cuid())
  key             String   @unique
  source          String
  sourceMessageId String?
  transactionId   String?
  status          String   @default("RECORDED")
  reason          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Category {
  id               String                @id @default(cuid())
  name             String                @unique
  description      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  transactions     Transaction[]
  merchantMappings MerchantCategoryMap[]
  budget           CategoryBudget?
}

model MerchantCategoryMap {
  id           String   @id @default(cuid())
  merchantKey  String   @unique
  merchantName String
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  confidence   Float    @default(0.95)
  source       String   @default("manual")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Goal {
  id            String    @id @default(cuid())
  title         String
  targetAmount  Float
  currentAmount Float     @default(0)
  monthlyTarget Float?
  goalType      String    @default("PURCHASE")
  status        String    @default("ACTIVE")
  priority      Int       @default(3)
  currency      String    @default("INR")
  targetDate    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  notes         String?
  icon          String?
  color         String?
}

model FinancialProfile {
  id                  String   @id @default(cuid())
  ownerName           String?
  currency            String   @default("INR")
  balance             Float    @default(0)
  emergencyFund       Float    @default(0)
  emergencyFundMonths Int      @default(6)
  monthlyIncome       Float    @default(0)
  monthlyExpenses     Float    @default(0)
  efStrategy          String   @default("BALANCED")

  // Investment Configuration Fields
  salaryCycleDays     Int      @default(33)
  autoSalaryCycle     Boolean  @default(true)

  // Phase Investable Rates (0-100)
  crisisInvestableRate         Float    @default(0)
  efBuildingInvestableRate     Float    @default(15)
  wealthBuildingInvestableRate Float    @default(100)
  goalSprintInvestableRate     Float    @default(40)

  // Standard Sub-Allocations (0-100)
  stdEquityPct        Float    @default(70)
  stdDebtPct          Float    @default(20)
  stdGoldPct          Float    @default(10)

  // Conservative (EF Building) Sub-Allocations (0-100)
  consEquityPct       Float    @default(30)
  consDebtPct         Float    @default(60)
  consGoldPct         Float    @default(10)

  // Equity Sub-Category Breakdown (0-100)
  equityNifty50Pct     Float    @default(60)
  equityNiftyNext50Pct Float    @default(20)
  equityMidcapPct      Float    @default(20)

  investmentStreak    Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model InvestmentSuggestion {
  id                String    @id @default(cuid())
  status            String    @default("ACTIVE") // ACTIVE, INVESTED, EXPIRED
  phase             String    // CRISIS, EF_BUILDING, WEALTH_BUILDING, GOAL_SPRINT
  cycleDays         Int       @default(33)
  rawSurplus        Float     @default(0)
  smoothedSurplus   Float     @default(0)
  investableRate    Float     @default(0)
  baseInvestable    Float     @default(0)
  spillover         Float     @default(0)
  totalInvestable   Float     @default(0)

  // Suggested values
  suggestedEquity   Float     @default(0)
  suggestedDebt     Float     @default(0)
  suggestedGold     Float     @default(0)

  // User edited values (null if unedited)
  editedEquity      Float?
  editedDebt        Float?
  editedGold        Float?
  isManuallyEdited  Boolean   @default(false)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  investedAt        DateTime?
}

model InvestmentHistory {
  id             String   @id @default(cuid())
  suggestionId   String
  phase          String
  rawSurplus     Float    @default(0)
  totalInvested  Float
  equity         Float    @default(0)
  debt           Float    @default(0)
  gold           Float    @default(0)
  investedAt     DateTime @default(now())
  notes          String?
}

model AIMemory {
  id        String    @id @default(cuid())
  key       String
  value     String
  tags      String    @default("[]")
  name      String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Subscription {
  id         String    @id @default(cuid())
  merchant   String
  amount     Float
  interval   String
  nextCharge DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model RecurringPattern {
  id              String   @id @default(cuid())
  description     String
  lastSeen        DateTime
  frequency       String
  estimatedAmount Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FinancialInsight {
  id        String   @id @default(cuid())
  type      String
  message   String
  score     Float?
  meta      String?
  createdAt DateTime @default(now())
}

model GmailSender {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model GmailWatch {
  id         String   @id @default(cuid())
  email      String   @unique
  historyId  String
  expiration DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model MutualFund {
  id                  String   @id @default(cuid())
  schemeName          String
  schemeCode          String?
  isin                String?
  planType            String
  option              String
  currentUnits        Float
  currentNav          Float?
  currentWorth        Float?
  setupDate           DateTime?
  processedMessageIds String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Stock {
  id                  String   @id @default(cuid())
  symbol              String
  exchange            String
  currentQuantity     Float
  currentPrice        Float?
  currentWorth        Float?
  setupDate           DateTime?
  processedMessageIds String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model PPFAccount {
  id                        String    @id @default(cuid())
  currentBalance            Float
  setupDate                 DateTime?
  monthlyMinimumBalance     Float
  accruedInterest           Float     @default(0)
  currentInterestRate       Float     @default(7.1)
  lastInterestRateFetchDate DateTime?
  currentWorth              Float?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}

model EPFAccount {
  id                          String    @id @default(cuid())
  currentBalance              Float
  monthlyEmployeeContribution Float
  monthlyEmployerContribution Float
  setupDate                   DateTime?
  epfCreditDay                Int       @default(15)
  annualInterestCreditDate    String    @default("03-31")
  accruedInterest             Float     @default(0)
  currentInterestRate         Float     @default(8.25)
  lastInterestRateFetchDate   DateTime?
  currentWorth                Float?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
}

model FDAccount {
  id                   String    @id @default(cuid())
  bankName             String
  principalAmount      Float
  startDate            DateTime
  maturityDate         DateTime?
  annualInterestRate   Float
  payoutType           String    @default("CUMULATIVE") // CUMULATIVE or NON_CUMULATIVE
  compoundingFrequency String    @default("QUARTERLY")  // QUARTERLY, MONTHLY, YEARLY, HALF_YEARLY
  isMatured            Boolean   @default(false)
  autoRenewal          Boolean   @default(false)
  currentWorth         Float     @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model RDAccount {
  id                   String    @id @default(cuid())
  bankName             String
  monthlyDepositAmount Float
  startDate            DateTime
  maturityDate         DateTime?
  annualInterestRate   Float
  compoundingFrequency String    @default("QUARTERLY")  // QUARTERLY, MONTHLY, YEARLY, HALF_YEARLY
  rdDepositDay         Int
  isMatured            Boolean   @default(false)
  autoRenewal          Boolean   @default(false)
  currentTotalDeposits Float     @default(0)
  currentWorth         Float     @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model VehicleAsset {
  id                 String    @id @default(cuid())
  type               String    // "BIKE" or "CAR"
  brand              String
  modelName          String
  variant            String
  manufacturingYear  Int
  purchaseDate       DateTime?
  purchasePrice      Float?
  fuelType           String?
  odometerAtSetup    Int?
  currentWorth       Float?
  lastValuationDate  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model PlotAsset {
  id                 String    @id @default(cuid())
  purchasePrice      Float?
  purchaseDate       DateTime?
  country            String
  state              String
  city               String
  locality           String
  area               Float
  areaUnit           String
  currentWorth       Float?
  lastValuationDate  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model IndependentPropertyAsset {
  id                 String    @id @default(cuid())
  purchasePrice      Float?
  purchaseDate       DateTime?
  country            String
  state              String
  city               String
  locality           String
  landArea           Float
  landAreaUnit       String
  builtUpArea        Float
  constructionYear   Int?
  lastRenovationYear Int?
  currentWorth       Float?
  lastValuationDate  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model ApartmentAsset {
  id                 String    @id @default(cuid())
  purchasePrice      Float?
  purchaseDate       DateTime?
  country            String
  state              String
  city               String
  locality           String
  builtUpArea        Float
  constructionYear   Int?
  bhk                String?
  floorNumber        String?
  builder            String?
  projectName        String?
  lastRenovationYear Int?
  currentWorth       Float?
  lastValuationDate  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model JewelleryAsset {
  id                 String    @id @default(cuid())
  metalType          String    // "GOLD", "SILVER", "PLATINUM"
  purity             Float     // e.g., 22 (for 22K), 24 (for 24K), 999 (for silver)
  netWeight          Float
  weightUnit         String    // "g" or "kg"
  purchaseDate       DateTime?
  purchasePrice      Float?
  currentWorth       Float?    @default(0)
  lastValuationDate  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model ReceivableAsset {
  id                 String    @id @default(cuid())
  name               String
  principalAmount    Float
  setupDate          DateTime?
  category           String    // "SECURITY_DEPOSIT", "PERSONAL_LOAN", "REFUNDABLE_DEPOSIT", "OTHER"
  expectedReturnDate DateTime?
  interestRate       Float?    @default(0)
  interestType       String    @default("NONE") // "NONE", "SIMPLE", "COMPOUND"
  accruedInterest    Float     @default(0)
  isOverdue          Boolean   @default(false)
  currentWorth       Float?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model LoanLiability {
  id                     String    @id @default(cuid())
  loanType               String    // "HOME", "CAR", "PERSONAL", "EDUCATION"
  outstandingBalance     Float
  interestRate           Float
  emiAmount              Float
  emiDebitDate           Int       @default(5) // Day of month 1-31
  interestType           String    // "FIXED", "FLOATING"
  remainingEmiCount      Int?
  lastEmiDeductionDate   DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model CreditCardLiability {
  id                       String    @id @default(cuid())
  currentOutstanding       Float
  statementGenerationDay   Int
  paymentDueDay            Int
  annualInterestRate       Float
  latePaymentFee           Float     @default(0)
  annualFee                Float     @default(0)
  annualFeeMonth           Int?
  minimumPaymentPercentage Float     @default(5.0)
  gstRateOnFees            Float     @default(18.0)
  lastStatementAmount      Float     @default(0)
  lastStatementDate        DateTime?
  amountPaidSinceStatement Float     @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model BnplLiability {
  id                       String    @id @default(cuid())
  provider                 String    // "Amazon Pay Later", "LazyPay", etc.
  currentOutstanding       Float
  monthlyInstallment       Float
  paymentDueDay            Int       // Day of the month (1-31)
  remainingInstallments    Int? 
  interestRate             Float     @default(0) // Usually 0 for BNPL if paid on time
  lateFee                  Float     @default(0)
  isClosed                 Boolean   @default(false)
  lastPaymentDeductionDate DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model BorrowedLiability {
  id                       String    @id @default(cuid())
  lenderName               String
  outstandingAmount        Float
  borrowDate               DateTime?
  interestRate             Float     @default(0)
  repaymentFrequency       String    @default("MONTHLY") // "MONTHLY", "QUARTERLY", "ONE_TIME"
  installmentAmount        Float?
  nextRepaymentDate        DateTime?
  latePenalty              Float?
  isClosed                 Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model CategoryBudget {
  id           String   @id @default(cuid())
  categoryId   String   @unique
  category     Category @relation(fields: [categoryId], references: [id])
  monthlyLimit Float
  rollover     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════════
// NORTH STOCK INTELLIGENCE — Market Data, Signals, Recommendations, Paper Trading
// ═══════════════════════════════════════════════════════════════════════════════

/// Daily OHLCV candle for a stock. Unique on (symbol, date, provider).
model StockMarketBar {
  id            String   @id @default(cuid())
  symbol        String
  exchange      String   @default("NSE")
  date          DateTime @db.Date
  open          Float
  high          Float
  low           Float
  close         Float
  adjustedClose Float?
  volume        Float
  provider      String   @default("YAHOO")
  quality       String   @default("VALID") // VALID, STALE, PARTIAL, INVALID, MISSING
  retrievedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([symbol, date, provider])
  @@index([symbol, date])
  @@index([date])
}

/// Computed indicator snapshot for a stock on a given date.
model StockSignal {
  id             String   @id @default(cuid())
  symbol         String
  date           DateTime @db.Date
  /// JSON blob of all computed indicators (StockIndicators type)
  indicators     String   @default("{}")
  /// JSON blob of scoring result (StockScore type)
  score          String   @default("{}")
  /// JSON blob of strategy signals (StrategySignal[] type)
  signals        String   @default("[]")
  /// Market regime at computation time
  marketRegime   String   @default("DATA_UNRELIABLE")
  /// Eligibility status
  eligible       Boolean  @default(false)
  eligibilityReasons String @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([symbol, date])
  @@index([date])
}

/// A single daily recommendation run — the top-level record for one pipeline execution.
model StockRecommendationRun {
  id                   String   @id @default(cuid())
  marketSessionDate    DateTime @db.Date
  marketRegime         String
  financialPhase       String
  /// JSON blob of CapitalAllocation
  capitalAllocation    String   @default("{}")
  dataQuality          String   @default("VALID")
  /// JSON blob of strategy versions used
  strategyVersions     String   @default("{}")
  candidateCount       Int      @default(0)
  eligibleCount        Int      @default(0)
  /// JSON blob of rejection reasons
  rejections           String   @default("[]")
  warnings             String   @default("[]")
  aiExplanation        String?
  status               String   @default("COMPLETE") // COMPLETE, PARTIAL, FAILED
  pipelineDurationMs   Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  items                StockRecommendationItem[]

  @@unique([marketSessionDate])
  @@index([marketSessionDate])
}

/// Individual recommendation within a run (Buy, Hold, or Sell).
model StockRecommendationItem {
  id                  String   @id @default(cuid())
  runId               String
  run                 StockRecommendationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  symbol              String
  exchange            String   @default("NSE")
  type                String   // BUY, HOLD, SELL
  /// JSON blob of full recommendation detail
  detail              String   @default("{}")
  createdAt           DateTime @default(now())

  @@index([runId])
  @@index([symbol])
}

/// Paper trading portfolio state (one active portfolio at a time).
model StockPaperPortfolio {
  id              String   @id @default(cuid())
  virtualCash     Float    @default(100000)
  initialCash     Float    @default(100000)
  equityPeak      Float    @default(100000)
  isActive        Boolean  @default(true)
  startDate       DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trades          StockPaperTrade[]
}

/// Individual paper trade record.
model StockPaperTrade {
  id              String   @id @default(cuid())
  portfolioId     String
  portfolio       StockPaperPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  symbol          String
  exchange        String   @default("NSE")
  strategy        String
  side            String   // BUY, SELL
  quantity        Int
  entryPrice      Float
  entryDate       DateTime
  exitPrice       Float?
  exitDate        DateTime?
  stopLoss        Float
  targetPrice     Float?
  status          String   @default("OPEN") // OPEN, CLOSED, STOPPED, EXPIRED
  pnl             Float    @default(0)
  pnlPct          Float    @default(0)
  costs           Float    @default(0)
  holdingDays     Int      @default(0)
  exitReason      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([portfolioId])
  @@index([symbol])
  @@index([status])
}

/// Backtest result persistence (one per strategy + date range).
model StockBacktestResult {
  id               String   @id @default(cuid())
  strategyName     String
  strategyVersion  String
  startDate        DateTime @db.Date
  endDate          DateTime @db.Date
  initialCapital   Float
  /// JSON blob of full BacktestResult
  result           String   @default("{}")
  createdAt        DateTime @default(now())

  @@index([strategyName])
}

/// Market data fetch log for provider health tracking.
model StockDataFetchLog {
  id              String   @id @default(cuid())
  provider        String
  symbolCount     Int      @default(0)
  successCount    Int      @default(0)
  failureCount    Int      @default(0)
  durationMs      Int      @default(0)
  errors          String   @default("[]")
  fetchedAt       DateTime @default(now())

  @@index([fetchedAt])
  @@index([provider])
}

/// Portfolio risk snapshot for drawdown tracking.
model StockPortfolioRiskSnapshot {
  id                          String   @id @default(cuid())
  equityPeak                  Float
  currentEquity               Float
  drawdownPct                 Float
  drawdownStatus              String   @default("NORMAL") // NORMAL, WARNING, RESTRICTED, HALTED
  directEquityExposurePct     Float    @default(0)
  totalEstEquityExposurePct   Float    @default(0)
  /// JSON blob of sector concentrations
  sectorConcentration         String   @default("{}")
  /// JSON blob of position concentrations
  positionConcentration       String   @default("{}")
  openPositionCount           Int      @default(0)
  cashPct                     Float    @default(100)
  snapshotAt                  DateTime @default(now())

  @@index([snapshotAt])
}
